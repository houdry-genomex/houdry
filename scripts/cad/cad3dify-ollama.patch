+import os
 import tempfile
 from string import Template
 
@@ -21,6 +22,23 @@ def index_map(index: int) -> str:
         return f"{index + 1}th"
 
 
+def _fill_output_path(generated_code: str, output_filepath: str) -> str:
+    """Substitute the output path into generated code, tolerating weak models.
+
+    Local models sometimes emit stray "$" characters (Template.substitute
+    raises) or hardcode "output.step" instead of using the placeholder.
+    """
+    tmpl = Template(generated_code)
+    try:
+        code = tmpl.substitute(output_filename=output_filepath)
+    except (KeyError, ValueError):
+        code = tmpl.safe_substitute(output_filename=output_filepath)
+    if output_filepath not in code:
+        for literal in ('"output.step"', "'output.step'", '"output.stp"', "'output.stp'"):
+            code = code.replace(literal, repr(output_filepath))
+    return code
+
+
